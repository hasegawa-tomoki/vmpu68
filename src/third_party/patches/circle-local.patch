diff --git a/lib/net/httpdaemon.cpp b/lib/net/httpdaemon.cpp
index e9a5a45..5fc945f 100644
--- a/lib/net/httpdaemon.cpp
+++ b/lib/net/httpdaemon.cpp
@@ -204,6 +204,13 @@ void CHTTPDaemon::Worker (void)
 		m_pMultipartBuffer = 0;
 	}
 
+	if (Status == HTTPResponseSent)		// vmpu68: the handler sent everything, just close
+	{
+		CloseAfterResponse ();
+
+		return;
+	}
+
 	if (Status != HTTPOK)
 	{
 		switch (Status)
@@ -284,6 +291,29 @@ void CHTTPDaemon::Worker (void)
 		}
 	}
 
+	CloseAfterResponse ();		// vmpu68: closes connection (passive close when the client closes first)
+}
+
+// vmpu68: wait briefly for the client to close first.  With "Connection: close"
+// the client closes as soon as the body is complete; deleting the socket before
+// its FIN arrives makes this side the active closer and the connection lingers
+// in TIME-WAIT (60 s).  Clients opening ~20 connections/s then hit
+// TCP_MAX_CONNECTIONS (1000) within a minute and new SYNs are refused (RST).
+// Taking the client's FIN first (CLOSE-WAIT -> LAST-ACK -> CLOSED) frees the
+// connection at once.  A client that does not close within the timeout is
+// closed actively as before.
+void CHTTPDaemon::CloseAfterResponse (void)
+{
+	assert (m_pSocket != 0);
+
+	m_pSocket->SetOptionReceiveTimeout (300000);		// 300 ms
+
+	u8 Buffer[64];
+	while (m_pSocket->Receive (Buffer, sizeof Buffer, 0) > 0)	// discard until closed / timeout
+	{
+		// nothing
+	}
+
 	delete m_pSocket;		// closes connection
 	m_pSocket = 0;
 }

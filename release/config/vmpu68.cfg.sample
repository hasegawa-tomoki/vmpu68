# vmpu68 設定ファイルサンプル
#
# このファイルを「vmpu68.cfg」という名前で SD カードの直下にコピーしてください。
# 「key=value」形式で 1行 1項目。# で始まる行と、ファームウェアが認識できない行は無視されます。
# (Wi-Fi の設定はこのファイルではなく wpa_supplicant.conf です)

# --- 表示名(任意、31 バイトまで) ---
# Web UI のヘッダ、/api/status、LAN 発見ビーコン(vhd68/vfd68 の機器一覧)に表示される名前です。
#name=X68000 XVI

# --- メイン RAM の容量(任意、MB 単位) ---
# 通常は指定不要です。起動のたびに 1 MB ごとに実バスを読んで(バスエラーが出る手前まで)
# 容量を検出します。検出結果が実際と違うときだけ 1〜12 の数字で固定してください。
#ram=4

# --- エミュレーションのクロック上限(任意、MHz 単位) ---
# 指定しない(0)と 68000 の実行速度に上限を設けません(概ね 100 MHz 相当)。
# 実機の速さで動かしたいときは XVI 相当なら 16、初代/ACE/EXPERT/PRO 相当なら 10 を指定します。
# コンソールの espd コマンドと同じ設定で、起動時に適用されます。
#mhz=16

# --- メイン RAM の扱い(任意) ---
# 1(既定)= ライトバック: Raspberry Pi 側のシャドウ RAM で動かし、実 RAM へは必要なときに書き戻す(速い)。
# 0 = ライトスルー: 書込みを毎回実 RAM にも行う。Web UI の「メイン RAM」で切り替えると書き換わります。
#wb=1

# --- JIT(68000 命令の AArch64 への実行時翻訳、任意) ---
# 1 で有効。既定は 1(1.1.0 から。0 は解釈実行)。全速力(mhz=0)のときだけ使われ、Web UI の「JIT ON|OFF」と
# コンソールの jit 1|0 で切り替えると、この行が書き換えられて保存されます。
#jit=1

# --- SMI 転送(V2.0.1 以降の基板、任意) ---
# Raspberry Pi と FPGA の間の転送に SoC の SMI(並列バス機能)を使うか。既定は 1。V1.0 では無視されます。
# Web UI の「SMI 転送 ON|OFF」、コンソールの smi 1|0、VMPU68.X の -t1|-t0 で切り替えると保存されます。
#smi=1

# --- 起動画面(任意) ---
# 1 で、X68000 の SRAM に起動プログラムを書き込み、電源 ON/リセットのたびに X68030 風の
# MPU/RAM/CLOCK 表示を 1.5 秒出してから通常の起動に進みます(Web UI の「起動画面 ON|OFF」と同じ)。
#sramboot=0

# --- 基板の版数(任意) ---
# Web UI の「基板」と、LAN の他の機器(vhd68/vfd68)の「近くの機器」に表示されます。省略時は判別結果から 1.0 / 2.0.1。
# V2.1(PSRAM 搭載)は判別できないので hw=2.1 を書いてください。
#hw=2.1

# --- バスクロックごとのタイミング(別ファイル vmpu68-bus.json、任意) ---
# 起動のたびにバスクロックを実測し(0.1 MHz 単位)、vmpu68-bus.json の "bus" 配列から
# min_mhz が実測以下で最大のクラスを選んで、その値を使います。ファイルがなければ内蔵の
# 既定(10 MHz 用と 16 MHz 用)です。書式は vmpu68-bus.json.sample を参照:
#   min_mhz  このクラスを使う最小クロック(MHz、小数 1 桁まで)
#   wr_setup 書込みデータを出してから AS までに余分に置くバスクロック数 0〜3、"auto" なら起動時に
#            RAM の末尾 4 KB で書込み検査をして欠落しない最小値を選ぶ(16 MHz では 2 になる)
#   wait_ns  バスコマンド後に最初に STATUS を確認するまでの待ち(ns)
#   io_mhz   再現する 68000 の I/O アクセス間隔の基準クロック(MHz)
#   ai       アドレス自動更新書込み(true/false)
# 24 MHz などのクロックアップ機は、例えば { "min_mhz": 20.0, ... } のクラスを足して調整してください。
